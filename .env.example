# Copie este arquivo para ".env" e preencha com seus próprios valores.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# ID do projeto Google Cloud usado para consultar o BigQuery via Base dos
# Dados (necessário para src/data/collect_anp.py). Veja o passo a passo no
# README.md.
BASEDOSDADOS_PROJECT_ID=

# API key gratuita da EIA (U.S. Energy Information Administration), usada
# para buscar a série do preço do petróleo Brent
# (src/data/collect_eia_brent.py). Gere a sua em:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=
